ANTHROPIC_API_KEY=sk-ant-your-key-here
APIFY_API_TOKEN=apify_api_your-token-here
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
Project_URL=https://your-project-ref.supabase.co
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
N8N_API_KEY=your-n8n-api-key

# Google OAuth — used by the Next.js app for "Continue with Google".
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Instagram DM Automation (Meta "Instagram API with Instagram Login") ---
# Full setup checklist: docs/DM-AUTOMATION-SETUP.md
# From your Meta app → Instagram → API setup with Instagram login:
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
# From App Settings → Basic (the app-level secret, used to verify webhooks):
FACEBOOK_APP_SECRET=your-facebook-app-secret
META_GRAPH_API_VERSION=v25.0
# Any random string; must match what you enter in the Meta webhook config:
WEBHOOK_VERIFY_TOKEN=pick-a-random-string
# 64 hex chars (32 bytes) for AES-256-GCM token encryption:
#   openssl rand -hex 32
ENCRYPTION_KEY=64-hex-chars
# Bearer token the system cron uses to call /api/cron/* routes:
#   openssl rand -hex 24
CRON_SECRET=pick-a-random-string
